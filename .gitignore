# IDE / 编辑器内部文件
.trae/
.vscode/
.idea/
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp
*.bak

# 本地运行时生成的临时文件（如有）
node_modules/

# Playwright / 测试运行产物（不入库，本地临时生成）
test-results/
playwright-report/
coverage/

# 真实样张文件（含可能的版权数据，不入库；本地保留供手动测试）
test/fixtures/real/

# Android 壳（CI 用 github actions 构建 APK）
# assets/ 由 android/sync-assets.sh 在 CI 构建前生成，不入库
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/
